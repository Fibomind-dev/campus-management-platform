<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Institution-scoped models
             ============================================================ -->

        <record id="gpj_rule_campus_user" model="ir.rule">
            <field name="name">GPJ: Campus - Institution isolation</field>
            <field name="model_id" ref="model_gpj_campus"/>
            <field name="domain_force">[('institution_id', 'in', user.gpj_institution_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_gpj_user')), (4, ref('group_gpj_readonly'))]"/>
        </record>

        <record id="gpj_rule_campus_admin" model="ir.rule">
            <field name="name">GPJ: Campus - Admin institution isolation</field>
            <field name="model_id" ref="model_gpj_campus"/>
