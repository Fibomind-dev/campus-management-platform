<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             GPJ Institutional Role - Actions
             ============================================================ -->
        <record id="action_gpj_institutional_role" model="ir.actions.act_window">
            <field name="name">Institutional Roles</field>
            <field name="res_model">gpj.institutional.role</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first institutional role
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institutional Role - List View
             ============================================================ -->
        <record id="view_gpj_institutional_role_list" model="ir.ui.view">
            <field name="name">gpj.institutional.role.list</field>
            <field name="model">gpj.institutional.role</field>
            <field name="arch" type="xml">
                <list string="Institutional Roles" multi_edit="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="description" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institutional Role - Kanban View
             ============================================================ -->
        <record id="view_gpj_institutional_role_kanban" model="ir.ui.view">
            <field name="name">gpj.institutional.role.kanban</field>
            <field name="model">gpj.institutional.role</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="description"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="code"/> •
                                        <field name="institution_id"/>
                                    </div>
                                    <div class="mt-1" t-if="record.description.raw_value">
                                        <span class="text-muted small"><i class="fa fa-info-circle me-1"></i></span><field name="description"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institutional Role - Form View
             ============================================================ -->
        <record id="view_gpj_institutional_role_form" model="ir.ui.view">
            <field name="name">gpj.institutional.role.form</field>
            <field name="model">gpj.institutional.role</field>
            <field name="arch" type="xml">
                <form string="Institutional Role">
                    <header>
                        <field name="active" widget="boolean_toggle" options='{"terminology": "archive"}'/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Basic Information">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="institution_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Details">
                                <field name="description" placeholder="Role description..."/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institutional Role - Search View
             ============================================================ -->
        <record id="view_gpj_institutional_role_search" model="ir.ui.view">
            <field name="name">gpj.institutional.role.search</field>
            <field name="model">gpj.institutional.role</field>
            <field name="arch" type="xml">
                <search string="Search Institutional Roles">
                    <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Institution" name="group_by_institution" context="{'group_by': 'institution_id'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>