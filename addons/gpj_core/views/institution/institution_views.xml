<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             GPJ Institution - Actions
             ============================================================ -->
        <record id="action_gpj_institution" model="ir.actions.act_window">
            <field name="name">Institutions</field>
            <field name="res_model">gpj.institution</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first institution
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution - List View
             ============================================================ -->
        <record id="view_gpj_institution_list" model="ir.ui.view">
            <field name="name">gpj.institution.list</field>
            <field name="model">gpj.institution</field>
            <field name="arch" type="xml">
                <list string="Institutions" multi_edit="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="dte_code" optional="show"/>
                    <field name="msbte_code" optional="show"/>
                    <field name="institution_type"/>
                    <field name="established_year" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution - Kanban View
             ============================================================ -->
        <record id="view_gpj_institution_kanban" model="ir.ui.view">
            <field name="name">gpj.institution.kanban</field>
            <field name="model">gpj.institution</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_type"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_res_partner_kanban">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="code"/> •
                                        <field name="institution_type" widget="badge"/>
                                    </div>
                                    <div class="mt-1" t-if="record.dte_code.raw_value">
                                        <span class="text-muted">DTE: </span><field name="dte_code"/>
                                    </div>
                                    <div class="mt-1" t-if="record.msbte_code.raw_value">
                                        <span class="text-muted">MSBTE: </span><field name="msbte_code"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution - Form View
             ============================================================ -->
        <record id="view_gpj_institution_form" model="ir.ui.view">
            <field name="name">gpj.institution.form</field>
            <field name="model">gpj.institution</field>
            <field name="arch" type="xml">
                <form string="Institution">
                    <header>
                        <field name="active" widget="boolean_toggle" options='{"terminology": "archive"}'/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_gpj_campus)d" type="action" class="oe_stat_button" icon="fa-building" context="{'default_institution_id': active_id}">
                                <field name="campus_ids" widget="statinfo" string="Campuses"/>
                            </button>
                            <button name="%(action_gpj_department)d" type="action" class="oe_stat_button" icon="fa-sitemap" context="{'default_institution_id': active_id}">
                                <field name="department_ids" widget="statinfo" string="Departments"/>
                            </button>
                            <button name="%(action_gpj_organizational_unit)d" type="action" class="oe_stat_button" icon="fa-users" context="{'default_institution_id': active_id}">
                                <field name="organizational_unit_ids" widget="statinfo" string="Org. Units"/>
                            </button>
                            <button name="%(action_gpj_designation)d" type="action" class="oe_stat_button" icon="fa-briefcase" context="{'default_institution_id': active_id}">
                                <field name="designation_ids" widget="statinfo" string="Designations"/>
                            </button>
                            <button name="%(action_gpj_institutional_role)d" type="action" class="oe_stat_button" icon="fa-user-tag" context="{'default_institution_id': active_id}">
                                <field name="institutional_role_ids" widget="statinfo" string="Roles"/>
                            </button>
                            <button name="%(action_gpj_institution_membership)d" type="action" class="oe_stat_button" icon="fa-users" context="{'default_institution_id': active_id}">
                                <field name="membership_ids" widget="statinfo" string="Memberships" invisible="1"/>
                            </button>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="institution_type"/>
                                <field name="established_year"/>
                            </group>
                            <group string="Codes">
                                <field name="dte_code"/>
                                <field name="msbte_code"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Campuses">
                                <field name="campus_ids">
                                    <list string="Campuses" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="address"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                    <form string="Campus">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="code"/>
                                                    <field name="institution_id" invisible="1"/>
                                                </group>
                                                <group>
                                                    <field name="address"/>
                                                    <field name="active" widget="boolean_toggle"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Departments">
                                <field name="department_ids">
                                    <list string="Departments" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="campus_id"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Organizational Units">
                                <field name="organizational_unit_ids">
                                    <list string="Organizational Units" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="parent_id"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Designations">
                                <field name="designation_ids">
                                    <list string="Designations" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Institutional Roles">
                                <field name="institutional_role_ids">
                                    <list string="Institutional Roles" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="description"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution - Search View
             ============================================================ -->
        <record id="view_gpj_institution_search" model="ir.ui.view">
            <field name="name">gpj.institution.search</field>
            <field name="model">gpj.institution</field>
            <field name="arch" type="xml">
                <search string="Search Institutions">
                    <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="dte_code"/>
                    <field name="msbte_code"/>
                    <field name="institution_type"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Government" name="type_government" domain="[('institution_type', '=', 'government')]"/>
                    <filter string="Aided" name="type_aided" domain="[('institution_type', '=', 'aided')]"/>
                    <filter string="Private" name="type_private" domain="[('institution_type', '=', 'private')]"/>
                    <group string="Group By">
                        <filter string="Type" name="group_by_type" context="{'group_by': 'institution_type'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>