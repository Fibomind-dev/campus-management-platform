<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             GPJ Department - Actions
             ============================================================ -->
        <record id="action_gpj_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">gpj.department</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first department
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Department - List View
             ============================================================ -->
        <record id="view_gpj_department_list" model="ir.ui.view">
            <field name="name">gpj.department.list</field>
            <field name="model">gpj.department</field>
            <field name="arch" type="xml">
                <list string="Departments" multi_edit="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="campus_id" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             GPJ Department - Kanban View
             ============================================================ -->
        <record id="view_gpj_department_kanban" model="ir.ui.view">
            <field name="name">gpj.department.kanban</field>
            <field name="model">gpj.department</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="campus_id"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="code"/> •
                                        <field name="institution_id"/>
                                    </div>
                                    <div class="mt-1" t-if="record.campus_id.raw_value">
                                        <span class="text-muted small"><i class="fa fa-building me-1"></i></span><field name="campus_id"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================
             GPJ Department - Form View
             ============================================================ -->
        <record id="view_gpj_department_form" model="ir.ui.view">
            <field name="name">gpj.department.form</field>
            <field name="model">gpj.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <header>
                        <field name="active" widget="boolean_toggle" options='{"terminology": "archive"}'/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Basic Information">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="institution_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Assignment">
                                <field name="campus_id" domain="[('institution_id', '=', institution_id)]" context="{'default_institution_id': institution_id}" options="{'no_create': True, 'no_open': True}"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             GPJ Department - Search View
             ============================================================ -->
        <record id="view_gpj_department_search" model="ir.ui.view">
            <field name="name">gpj.department.search</field>
            <field name="model">gpj.department</field>
            <field name="arch" type="xml">
                <search string="Search Departments">
                    <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="campus_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Institution" name="group_by_institution" context="{'group_by': 'institution_id'}"/>
                        <filter string="Campus" name="group_by_campus" context="{'group_by': 'campus_id'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>