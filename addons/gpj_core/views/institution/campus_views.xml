<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             GPJ Campus - Actions
             ============================================================ -->
        <record id="action_gpj_campus" model="ir.actions.act_window">
            <field name="name">Campuses</field>
            <field name="res_model">gpj.campus</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first campus
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Campus - List View
             ============================================================ -->
        <record id="view_gpj_campus_list" model="ir.ui.view">
            <field name="name">gpj.campus.list</field>
            <field name="model">gpj.campus</field>
            <field name="arch" type="xml">
                <list string="Campuses" multi_edit="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="address" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             GPJ Campus - Kanban View
             ============================================================ -->
        <record id="view_gpj_campus_kanban" model="ir.ui.view">
            <field name="name">gpj.campus.kanban</field>
            <field name="model">gpj.campus</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="code"/> •
                                        <field name="institution_id"/>
                                    </div>
                                    <div class="mt-1" t-if="record.address.raw_value">
                                        <span class="text-muted small"><i class="fa fa-map-marker me-1"></i></span><field name="address"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================
             GPJ Campus - Form View
             ============================================================ -->
        <record id="view_gpj_campus_form" model="ir.ui.view">
            <field name="name">gpj.campus.form</field>
            <field name="model">gpj.campus</field>
            <field name="arch" type="xml">
                <form string="Campus">
                    <header>
                        <field name="active" widget="boolean_toggle" options='{"terminology": "archive"}'/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_gpj_department)d" type="action" class="oe_stat_button" icon="fa-sitemap" context="{'default_campus_id': id, 'default_institution_id': institution_id}">
                                <field name="department_ids" widget="statinfo" string="Departments"/>
                            </button>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="name"/>
                                <field name="code"/>
                                <!-- <field name="institution_id" options="{'no_create': True, 'no_open': True}"/> -->
                                <field name="institution_id"/>
                            </group>
                            <group string="Details">
                                <field name="address" widget="text" placeholder="Campus address..."/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             GPJ Campus - Search View
             ============================================================ -->
        <record id="view_gpj_campus_search" model="ir.ui.view">
            <field name="name">gpj.campus.search</field>
            <field name="model">gpj.campus</field>
            <field name="arch" type="xml">
                <search string="Search Campuses">
                    <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="institution_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Institution" name="group_by_institution" context="{'group_by': 'institution_id'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>