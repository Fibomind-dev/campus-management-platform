<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             GPJ Core Dashboard - Native Odoo Action
             ============================================================ -->
        <record id="action_gpj_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">gpj.institution</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first institution to begin
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Core Dashboard - OWL Client Action
             ============================================================ -->
        <record id="action_gpj_dashboard_client" model="ir.actions.client">
            <field name="name">GPJ Dashboard</field>
            <field name="tag">gpj_dashboard</field>
        </record>

    </data>
</odoo>
