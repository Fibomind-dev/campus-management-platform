<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             GPJ Institution Membership - Actions
             ============================================================ -->
        <record id="action_gpj_institution_membership" model="ir.actions.act_window">
            <field name="name">Memberships</field>
            <field name="res_model">gpj.institution.membership</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first membership
                </p>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution Membership - List View
             ============================================================ -->
        <record id="view_gpj_institution_membership_list" model="ir.ui.view">
            <field name="name">gpj.institution.membership.list</field>
            <field name="model">gpj.institution.membership</field>
            <field name="arch" type="xml">
                <list string="Memberships" multi_edit="1">
                    <field name="user_id"/>
                    <field name="institution_id"/>
                    <field name="role_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    <field name="is_default"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution Membership - Form View
             ============================================================ -->
        <record id="view_gpj_institution_membership_form" model="ir.ui.view">
            <field name="name">gpj.institution.membership.form</field>
            <field name="model">gpj.institution.membership</field>
            <field name="arch" type="xml">
                <form string="Institution Membership">
                    <header>
                        <field name="active" widget="boolean_toggle" options='{"terminology": "archive"}'/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Assignment">
                                <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="institution_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Roles &amp; Status">
                                <field name="role_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                <field name="is_default"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             GPJ Institution Membership - Search View
             ============================================================ -->
        <record id="view_gpj_institution_membership_search" model="ir.ui.view">
            <field name="name">gpj.institution.membership.search</field>
            <field name="model">gpj.institution.membership</field>
            <field name="arch" type="xml">
                <search string="Search Memberships">
                    <field name="user_id" string="User" filter_domain="['|', ('user_id.name', 'ilike', self), ('user_id.login', 'ilike', self)]"/>
                    <field name="institution_id"/>
                    <field name="role_ids"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Default" name="is_default" domain="[('is_default', '=', True)]"/>
                    <group>
                        <filter string="Institution" name="group_by_institution" context="{'group_by': 'institution_id'}"/>
                        <filter string="User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>