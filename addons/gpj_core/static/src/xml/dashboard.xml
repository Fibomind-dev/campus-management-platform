<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="gpj_core.gpj_dashboard_template">

        <div class="o_gpj_dashboard container-fluid py-4">

            <!-- ========================================================
                 HEADER
                 ======================================================== -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1 class="h3 mb-1">
                        GPJ Core Dashboard
                    </h1>

                    <p class="text-muted mb-0">
                        Institution management overview
                    </p>

                </div>

                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    t-on-click="reloadDashboard"
                    t-att-disabled="state.loading"
                >
                    <i class="fa fa-refresh me-1"/>
                    Refresh
                </button>

            </div>


            <!-- ========================================================
                 LOADING
                 ======================================================== -->

            <t t-if="state.loading">

                <div class="text-center py-5">

                    <i class="fa fa-spinner fa-spin fa-2x mb-3"/>

                    <div class="text-muted">
                        Loading dashboard...
                    </div>

                </div>

            </t>


            <!-- ========================================================
                 ERROR
                 ======================================================== -->

            <t t-elif="state.error">

                <div class="alert alert-danger">

                    <strong>
                        Unable to load dashboard.
                    </strong>

                    <div class="mt-2">
                        Please refresh the page and try again.
                    </div>

                    <button
                        type="button"
                        class="btn btn-danger mt-3"
                        t-on-click="reloadDashboard"
                    >
                        Retry
                    </button>

                </div>

            </t>


            <!-- ========================================================
                 MAIN DASHBOARD
                 ======================================================== -->

            <t t-else="">


                <!-- ====================================================
                     STAT CARDS
                     ==================================================== -->

                <div class="row g-3 mb-4">

                    <t
                        t-foreach="state.stats"
                        t-as="stat"
                        t-key="stat.id"
                    >

                        <div class="col-12 col-md-6 col-xl-4">

                            <div
                                class="card h-100 shadow-sm border-0"
                                style="cursor: pointer;"
                                t-att-data-action="stat.actionXmlId"
                                t-att-data-mode="stat.viewMode"
                                t-on-click="handleStatClick"
                            >

                                <div class="card-body">

                                    <div
                                        class="d-flex justify-content-between align-items-start"
                                    >

                                        <div>

                                            <div class="text-muted small">
                                                <t t-esc="stat.label"/>
                                            </div>

                                            <div class="fs-2 fw-semibold">
                                                <t t-esc="stat.value"/>
                                            </div>

                                        </div>


                                        <span
                                            t-att-class="'badge bg-' + stat.color"
                                        >
                                            <t t-esc="stat.trendText"/>
                                        </span>

                                    </div>


                                    <div class="mt-3 text-muted">

                                        <i
                                            t-att-class="'fa ' + stat.icon + ' me-2'"
                                        />

                                        View
                                        <t t-esc="stat.label"/>

                                        <i class="fa fa-arrow-right ms-1"/>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </t>

                </div>


                <!-- ====================================================
                     QUICK ACTIONS
                     ==================================================== -->

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-header bg-white">

                        <h2 class="h5 mb-0">
                            Quick Actions
                        </h2>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">

                            <t
                                t-foreach="state.quickActions"
                                t-as="action"
                                t-key="action.id"
                            >

                                <div class="col-12 col-md-6 col-lg-3">

                                    <button
                                        type="button"
                                        t-att-class="'btn ' + action.btnClass + ' w-100 py-3'"
                                        t-att-data-action="action.actionXmlId"
                                        t-att-data-mode="action.viewMode"
                                        t-on-click="handleQuickAction"
                                    >

                                        <i
                                            t-att-class="'fa ' + action.icon + ' me-2'"
                                        />

                                        <t t-esc="action.label"/>

                                    </button>

                                </div>

                            </t>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     ALERTS + ACTIVITY
                     ==================================================== -->

                <div class="row g-3">


                    <!-- ==================================================
                         ALERTS
                         ================================================== -->

                    <div class="col-12 col-lg-6">

                        <div class="card h-100 shadow-sm border-0">

                            <div
                                class="card-header bg-white d-flex justify-content-between align-items-center"
                            >

                                <h2 class="h5 mb-0">
                                    Alerts
                                </h2>

                                <span class="badge bg-danger">
                                    <t t-esc="state.alertsCount"/>
                                </span>

                            </div>


                            <div class="card-body">

                                <t t-if="state.alerts.length">

                                    <t
                                        t-foreach="state.alerts"
                                        t-as="alert"
                                        t-key="alert.id"
                                    >

                                        <div class="border-bottom py-3">

                                            <div
                                                class="fw-semibold"
                                            >
                                                <t t-esc="alert.title"/>
                                            </div>

                                            <div
                                                class="small text-muted"
                                            >
                                                <t t-esc="alert.message"/>
                                            </div>

                                            <div
                                                class="small text-muted mt-1"
                                            >
                                                <t t-esc="alert.time"/>
                                            </div>

                                        </div>

                                    </t>

                                </t>

                                <t t-else="">

                                    <div class="text-muted">
                                        No alerts.
                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>


                    <!-- ==================================================
                         RECENT ACTIVITY
                         ================================================== -->

                    <div class="col-12 col-lg-6">

                        <div class="card h-100 shadow-sm border-0">

                            <div class="card-header bg-white">

                                <h2 class="h5 mb-0">
                                    Recent Activity
                                </h2>

                            </div>


                            <div class="card-body">

                                <t
                                    t-foreach="state.activities"
                                    t-as="activity"
                                    t-key="activity.id"
                                >

                                    <div class="border-bottom py-3">

                                        <div class="d-flex align-items-start">

                                            <i
                                                t-att-class="'fa ' + activity.icon + ' me-2 mt-1 text-muted'"
                                            />

                                            <div>

                                                <div class="small">

                                                    <strong>
                                                        <t t-esc="activity.title"/>
                                                    </strong>

                                                    <div class="text-muted">
                                                        <t t-esc="activity.message"/>
                                                    </div>

                                                </div>

                                                <div
                                                    class="small text-muted mt-1"
                                                >
                                                    <t t-esc="activity.time"/>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>