<odoo>
    <record id="view_partner_form_inherit_simple_notes" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.simple.notes</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Notes" name="simple_notes_page">
                    <field name="simple_notes_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="content"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>